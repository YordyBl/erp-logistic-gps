# Copy to .env for local development. Never commit real secrets.
# The docker-compose files only use these values; real deployments inject
# secrets from outside the repository.

# Runtime
NODE_ENV=development
TZ=America/Lima

# Host ports published by docker compose (container ports stay fixed:
# api 3000, web 8080, postgres 5432, minio 9000/9001).
API_PORT=3000
WEB_PORT=8080
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL
# POSTGRES_HOST is for tools running on the host; containers reach the database
# through the compose service name `postgres`.
POSTGRES_HOST=localhost
POSTGRES_DB=erp_logistic
POSTGRES_USER=erp_logistic
POSTGRES_PASSWORD=change-me-local-only

# MinIO (S3-compatible evidence storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local-only

# The api and migrations containers get DATABASE_URL derived by
# docker-compose.yml from the POSTGRES_* values above, so the password lives in
# one place. Uncomment only to override the connection string.
# DATABASE_URL=postgres://erp_logistic:change-me-local-only@postgres:5432/erp_logistic

# JWT (generate a real value with: openssl rand -hex 32)
JWT_SECRET=replace-with-32-byte-random-hex
JWT_ISSUER=erp-logistic-api
JWT_AUDIENCE=erp-logistic-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Auth HTTP (COOKIE_SECURE=false only for local plain-HTTP development)
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# HTTP
CORS_ORIGIN=http://localhost:8080
