# Copy to .env for local development. Never commit real secrets.

# Runtime
NODE_ENV=development
TZ=America/Lima
API_PORT=3000
WEB_PORT=5173

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erp_logistic
POSTGRES_USER=erp_logistic
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://erp_logistic:change-me-local-only@localhost:5432/erp_logistic

# JWT (generate real values with: openssl rand -hex 32)
JWT_ACCESS_SECRET=replace-with-32-byte-random-hex
JWT_REFRESH_TOKEN_PEPPER=replace-with-32-byte-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=erp-logistic-api
JWT_AUDIENCE=erp-logistic-web

# HTTP
CORS_ORIGIN=http://localhost:5173
