---
import { TRACK_STEPS, TRACKING } from '../data/content';
import Icon from './Icon.astro';
import { ICON } from './icons';
import MapBackdrop from './MapBackdrop.astro';
---
<section id="seguimiento" aria-labelledby="seg-title" class="section-wash">
  <div class="container split">
    <div class="stack intro">
      <span class="pill">Para tus clientes · próximamente</span>
      <h2 id="seg-title" class="disp h2">Tus clientes ven su pedido sin llamarte.</h2>
      <p class="lead">Cuando sale la ruta, cada destinatario recibe un enlace por WhatsApp con tu marca. Ve a cuántas paradas está el motorizado y la foto cuando se entrega. Menos llamadas a tu central preguntando «¿y mi pedido?».</p>
      <ul class="checks">
        {TRACKING.map((t) => (
          <li><span class="tick"><Icon d={ICON.check} size={12} stroke={3} /></span><span><strong>{t.title}</strong> <span class="body">{t.body}</span></span></li>
        ))}
      </ul>
    </div>

    <figure class="card view" aria-label="Ejemplo de lo que ve el destinatario">
      <figcaption class="card-head">
        <strong>Courier Express · tu pedido</strong>
        <span class="mono">LIM-0144 · actualizado hace 30 s</span>
      </figcaption>
      <div class="grid">
        <div class="side">
          <div class="eta">
            <span class="for">Librería Ática · 2 cajas</span>
            <strong class="disp">Llega entre <span class="mono">10:40</span> y <span class="mono">11:00</span></strong>
            <span class="near">María está a 2 paradas de ti</span>
          </div>
          <ol class="steps">
            {TRACK_STEPS.map((s, i) => (
              <li class={s.state}>
                <span class="rail"><span class="dot" />{i < TRACK_STEPS.length - 1 && <span class="line" />}</span>
                <span class="what"><span class="title">{s.title}</span><span class="detail">{s.detail}</span></span>
                <span class="mono time">{s.time}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="map-box">
          <MapBackdrop label="Mapa de ejemplo con el repartidor a dos paradas de la dirección de entrega">
            <svg viewBox="0 0 400 340" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <path d="M60 280 C 130 240, 190 200, 320 90" stroke="#0c7a4b" stroke-width="5" fill="none" stroke-linecap="round" stroke-dasharray="2 10" />
              <circle cx="60" cy="280" r="16" fill="#0c7a4b" opacity="0.18" />
              <circle cx="60" cy="280" r="9" fill="#0c7a4b" stroke="#ffffff" stroke-width="3" />
              <circle cx="150" cy="222" r="6" fill="#ffffff" stroke="#5a665f" stroke-width="3" />
              <circle cx="230" cy="165" r="6" fill="#ffffff" stroke="#5a665f" stroke-width="3" />
              <path d="M320 62c-12 0-20 8-20 19 0 15 20 33 20 33s20-18 20-33c0-11-8-19-20-19z" fill="#073d27" />
              <circle cx="320" cy="81" r="6" fill="#ffffff" />
            </svg>
          </MapBackdrop>
          <span class="map-tag">Solo ve su pedido y su dirección</span>
        </div>
      </div>
    </figure>
  </div>
</section>

<style>
  .intro { flex: 1 1 340px; }
  .view { flex: 1.9 1 560px; min-width: 0; }
  .grid { display: flex; flex-wrap: wrap; min-height: 380px; }
  .side { flex: 1 1 250px; min-width: 0; border-right: 1px solid var(--line); padding: 18px; display: flex; flex-direction: column; gap: 16px; }
  .eta { display: flex; flex-direction: column; gap: 4px; }
  .for { font-size: 12px; color: var(--muted); }
  .eta strong { font-size: 20px; line-height: 1.1; }
  .near { font-size: 13px; color: var(--green-text); font-weight: 600; }
  .steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .steps li { display: grid; grid-template-columns: 16px minmax(0, 1fr) auto; gap: 10px; padding-bottom: 12px; }
  .rail { display: flex; flex-direction: column; align-items: center; }
  .dot { width: 14px; height: 14px; border-radius: 50%; margin-top: 3px; border: 3px solid #c9d0c6; background: #ffffff; }
  .line { flex: 1; width: 2px; margin-top: 4px; background: var(--line); }
  .done .dot { background: var(--green); border-color: var(--green); }
  .done .line { background: var(--green); }
  .current .dot { border-color: var(--amber); }
  .what { display: flex; flex-direction: column; }
  .title { font-size: 14px; font-weight: 500; }
  .current .title { font-weight: 650; }
  .detail, .time { font-size: 12px; color: var(--muted); }
  .map-box { flex: 2.6 1 320px; min-width: 0; position: relative; min-height: 320px; }
  @media (max-width: 640px) { .side { border-right: 0; } }
</style>
