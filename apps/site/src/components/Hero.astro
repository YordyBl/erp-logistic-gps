---
import { Picture } from 'astro:assets';

import lima from '../assets/lima-costa.webp';
import Icon from './Icon.astro';
import { ICON } from './icons';

const STOPS = [
  { address: 'Av. Larco 1150, Miraflores', time: '09:12', state: 'done' },
  { address: 'Calle Las Begonias 441, San Isidro', time: '10:42', state: 'done' },
  { address: 'Jr. Bolognesi 455, Barranco', time: 'Siguiente', state: 'next' },
  { address: 'Av. Grau 320, Chorrillos', time: '', state: 'pending' },
] as const;
---
<section id="inicio" aria-labelledby="hero-title">
  <Picture src={lima} alt="" formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 1024, 1440]} sizes="100vw"
    loading="eager" fetchpriority="high" class="photo" />
  <div class="veil" aria-hidden="true"></div>

  <div class="inner">
    <div class="copy">
      <span class="badge glass"><Icon d={ICON.truck} size={16} color="#86efac" /> Reparto de última milla en Lima y Callao</span>
      <h1 id="hero-title" class="disp">Cada entrega en Lima, con <span>prueba</span>.</h1>
      <p>Arma las rutas, sigue a tus motorizados y guarda la foto, la hora y quién recibió cada pedido. Sin Excel, sin cuaderno, sin perseguir a nadie por WhatsApp.</p>
      <div class="ctas">
        <a href="#demo" class="btn btn-amber btn-lg">Pedir una demo <Icon d={ICON.arrow} size={18} stroke={2.2} /></a>
        <a href="#producto" class="btn btn-glass btn-lg glass">Ver el producto</a>
      </div>
      <ul class="facts">
        <li><Icon d={ICON.check} size={16} stroke={2.5} color="#86efac" />Lima y Callao</li>
        <li><Icon d={ICON.check} size={16} stroke={2.5} color="#86efac" />Moto o camioneta</li>
      </ul>
    </div>

    <div class="preview" role="group" aria-label="Ejemplo de lo que ve el operador">
      <div class="panel glass pop" style="animation-delay: .4s">
        <div class="route-head">
          <div class="who">
            <strong class="mono">R-0408</strong>
            <span>María Rojas · moto <span class="mono">BXK-482</span></span>
          </div>
          <span class="status">En ruta</span>
        </div>
        <ol class="stops">
          {STOPS.map((stop) => (
            <li class={stop.state}>
              <span class="dot">{stop.state === 'done' && <Icon d={ICON.check} size={11} stroke={3} />}</span>
              <span class="address">{stop.address}</span>
              {stop.time && <span class:list={['time', { mono: stop.state === 'done' }]}>{stop.time}</span>}
            </li>
          ))}
        </ol>
      </div>
      <div class="panel glass pop delivered" style="animation-delay: .9s">
        <span class="cam"><Icon d={ICON.camera} color="#86efac" /></span>
        <span class="text"><strong>LIM-0142 entregado</strong><span>Recibió Carmen Paredes · 2 fotos · 10:42</span></span>
      </div>
    </div>
  </div>
</section>

<style>
  section { position: relative; overflow: hidden; background: #0b2e20; color: #ffffff; }
  .photo, .photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 60%; }
  .veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(6,24,16,0.74) 0%, rgba(6,24,16,0.48) 55%, rgba(6,24,16,0.22) 100%); }
  .inner { position: relative; max-width: 1200px; margin: 0 auto; padding: 72px 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 48px; }
  .copy { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .badge {
    display: inline-flex; align-items: center; gap: 8px; width: fit-content; padding: 6px 12px; border-radius: 999px;
    border: 1px solid rgba(134,239,172,0.5); background: rgba(34,197,94,0.3); font-size: 13px; font-weight: 500;
  }
  h1 { margin: 0; font-size: clamp(38px, 4.6vw, 62px); line-height: 1.02; max-width: 10em; text-wrap: balance; }
  h1 span { color: var(--amber); }
  .copy > p { margin: 0; font-size: 17px; color: rgba(240,253,244,0.92); max-width: 31em; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .facts { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 14px; color: rgba(240,253,244,0.9); }
  .facts li { display: flex; align-items: center; gap: 8px; }

  .preview { flex: 1 1 340px; min-width: 0; max-width: 420px; display: flex; flex-direction: column; gap: 12px; }
  .panel { padding: 18px; border-radius: 14px; background: rgba(255,255,255,0.12); border: 1px solid rgba(74,222,128,0.35); display: flex; flex-direction: column; gap: 14px; }
  .pop { opacity: 0; transform: translateY(8px); animation: pop 0.6s cubic-bezier(0.16,1,0.3,1) forwards; }
  @keyframes pop { to { opacity: 1; transform: none; } }
  .route-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .who { display: flex; flex-direction: column; }
  .who strong { font-size: 16px; }
  .who > span { font-size: 13px; color: rgba(240,253,244,0.9); }
  .status { font-size: 12px; padding: 3px 10px; border-radius: 999px; background: rgba(34,197,94,0.3); border: 1px solid rgba(134,239,172,0.5); }
  .stops { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 13px; }
  .stops li { display: flex; align-items: center; gap: 10px; }
  .dot { width: 18px; height: 18px; border-radius: 50%; flex: none; display: grid; place-items: center; }
  .done .dot { background: #86efac; color: #0b2e20; }
  .next .dot { border: 3px solid var(--amber); }
  .pending { color: rgba(240,253,244,0.8); }
  .pending .dot { border: 2px solid rgba(255,255,255,0.5); }
  .address { flex: 1; }
  .next .address { font-weight: 600; }
  .time { color: rgba(240,253,244,0.85); }
  .next .time { color: #ffd08a; }
  .delivered { flex-direction: row; align-items: center; gap: 12px; padding: 14px 18px; }
  .cam { width: 40px; height: 40px; border-radius: 10px; background: rgba(34,197,94,0.3); display: grid; place-items: center; flex: none; }
  .text { display: flex; flex-direction: column; font-size: 13px; }
  .text strong { font-size: 14px; }
  .text span { color: rgba(240,253,244,0.9); }
  @media (prefers-reduced-motion: reduce) { .pop { opacity: 1; transform: none; } }
</style>
