---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada · ERP Logistic" noindex>
  <Header />
  <main class="nf">
    <h1 class="disp">No encontramos esta página.</h1>
    <p>Si esperas un paquete, usa el enlace que te envió tu empresa de reparto.</p>
    <a href="/" class="btn btn-green">Volver al inicio</a>
  </main>
  <Footer />
</Base>

<style>
  .nf { max-width: 760px; margin: 0 auto; padding: 88px 24px; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  h1 { margin: 0; font-size: clamp(26px, 2.8vw, 34px); line-height: 1.1; }
  p { margin: 0; font-size: 15px; color: var(--ink-2); }
</style>
